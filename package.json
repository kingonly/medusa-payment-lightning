{
  "name": "medusa-payment-lightning",
  "version": "0.1.0",
  "description": "Bitcoin (Lightning) payment provider for Medusa v2. Customers pay a Lightning invoice, funds land in the merchant's own Glow wallet; no node, no custody, no SDK.",
  "author": "Roy Sheinfeld",
  "license": "MIT",
  "files": [
    ".medusa/server",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./lib/lightning": "./.medusa/server/src/lib/lightning/index.js",
    "./storefront": {
      "types": "./dist/storefront/index.d.ts",
      "default": "./dist/storefront/index.js"
    },
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "medusa-plugin",
    "medusa-v2",
    "medusa-plugin-payment",
    "payment",
    "bitcoin",
    "lightning",
    "lightning-network",
    "lnurl",
    "breez",
    "glow"
  ],
  "scripts": {
    "build": "medusa plugin:build && tsc -p tsconfig.storefront.json",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.storefront.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.21.0",
    "@medusajs/cli": "2.21.0",
    "@medusajs/eslint-plugin": "2.21.0",
    "@medusajs/framework": "2.21.0",
    "@medusajs/icons": "2.21.0",
    "@medusajs/medusa": "2.21.0",
    "@medusajs/test-utils": "2.21.0",
    "@medusajs/ui": "4.2.4",
    "@swc/core": "^1.7.28",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jiti": "^2.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53",
    "vitest": "^3.2.0",
    "@medusajs/js-sdk": "2.21.0"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.19.0",
    "@medusajs/cli": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/icons": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/test-utils": "^2.19.0",
    "@medusajs/ui": "^4.0.0",
    "@medusajs/js-sdk": "^2.19.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingonly/medusa-payment-lightning.git"
  },
  "homepage": "https://github.com/kingonly/medusa-payment-lightning#readme",
  "bugs": {
    "url": "https://github.com/kingonly/medusa-payment-lightning/issues"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@medusajs/js-sdk": {
      "optional": true
    }
  }
}
